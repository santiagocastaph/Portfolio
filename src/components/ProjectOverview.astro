---
const { project } = Astro.props;
---

<section class="bg-black text-white py-10 border-t border-neutral-900">

  <div class="max-w-4xl mx-auto px-8">

    <div class="max-w-2xl">

      <h2 class="font-serif text-2xl md:text-4xl leading-tight tracking-[-0.03em]">
        Produced for the{" "}
        <em>{project.competition}</em>
      </h2>

      <p class="mt-5 uppercase tracking-[0.35em] text-xs text-neutral-500">
        Camera Department
      </p>

    </div>

  </div>

</section>
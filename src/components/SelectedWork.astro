---
import { projects } from "../data/projects";

const workProjects = projects.slice(1);
---

<section class="bg-black text-white pt-56 pb-40">

  <div class="max-w-7xl mx-auto px-8">

    <div class="mb-32">

      <p class="uppercase tracking-[0.45em] text-xs text-neutral-500">

        Motion

      </p>

    </div>

    <div class="space-y-56">

      {workProjects.map((project) => (

        <a
          href={`/work/${project.slug}`}
          class="block group"
        >

          <article>

            <div class="overflow-hidden">

              <img
                src={project.hero}
                alt={project.title}
                class="w-full h-[80vh] object-cover transition duration-700 group-hover:scale-[1.02]"
              />

            </div>

            <div class="mt-14 flex justify-between items-end">

              <div>

                <h2 class="font-serif text-6xl md:text-8xl tracking-[-0.05em] leading-none transition duration-300 group-hover:text-neutral-300">

                  {project.title}

                </h2>

                <p class="mt-5 uppercase tracking-[0.3em] text-xs text-neutral-500">

                  {project.role}

                </p>

              </div>

              <p class="text-neutral-500">

                {project.year}

              </p>

            </div>

          </article>

        </a>

      ))}

    </div>

  </div>

</section>
---
const { festivals = [] } = Astro.props;
---

{
  festivals.length > 0 && (

    <section class="bg-black text-white py-24 border-t border-neutral-900 border-b border-neutral-900">

      <div class="max-w-7xl mx-auto px-8">

        <p class="uppercase tracking-[0.45em] text-xs text-neutral-500 mb-16">
          Recognition
        </p>

        <div
          class:list={[
            festivals.length === 1
              ? "flex justify-center"
              : "grid md:grid-cols-2 xl:grid-cols-3 gap-28"
          ]}
        >

          {festivals.map((festival) => (

            <article class="w-full max-w-md text-center">

<div class="inline-flex items-center justify-center gap-0 mb-5">
                <img
                  src="/icons/laurel-left.svg"
                  alt=""
                  aria-hidden="true"
                  class="w-20 md:w-24 shrink-0 -mr-4"
                />

<h3 class="inline-block font-serif text-3xl md:text-4xl leading-tight tracking-[-0.03em] text-center">                  {festival.festival}
                </h3>

                <img
                  src="/icons/laurel-right.svg"
                  alt=""
                  aria-hidden="true"
                  class="w-20 md:w-24 shrink-0 -ml-4"
                />

              </div>

              <p class="uppercase tracking-[0.45em] text-[10px] text-neutral-500">
                {festival.year}
              </p>

              <div class="w-20 h-px bg-neutral-800 mx-auto my-8"></div>

              <div class="space-y-6">

                {festival.recognitions.map((recognition) => (

                  <div>

                    <p class="uppercase tracking-[0.45em] text-[10px] text-neutral-500">
                      {recognition.category}
                    </p>

                    <p class="mt-2 font-serif text-xl leading-snug">
                      {recognition.title}
                    </p>

                  </div>

                ))}

              </div>

            </article>

          ))}

        </div>

      </div>

    </section>

  )
}
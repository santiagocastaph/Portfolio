---
const { project } = Astro.props;

const images = project.behindTheScenes ?? [];
---

{
  images.length > 0 && (

    <section class="bg-black border-t border-neutral-900 border-b border-neutral-900 py-12">

      <div class="max-w-7xl mx-auto px-8">

        <div class="flex justify-center items-end gap-6 overflow-x-auto scrollbar-hide">

          {images.map((image) => (

            <figure class="flex-shrink-0 h-[220px]">

              <img
                src={image.image}
                alt={`${project.title} On Set`}
                class="h-full w-auto object-contain"
              />

            </figure>

          ))}

        </div>

      </div>

    </section>

  )
}
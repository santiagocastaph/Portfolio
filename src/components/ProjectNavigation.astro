---
const { project, projects } = Astro.props;

const currentIndex = projects.findIndex(
  (p) => p.slug === project.slug
);

const next =
  currentIndex < projects.length - 1
    ? projects[currentIndex + 1]
    : null;
---

<section class="bg-black text-white py-10 border-t border-neutral-900">

  <div class="max-w-7xl mx-auto px-8">

    <div class="flex items-center justify-between">

      <a
  href="/motion"
  class="uppercase tracking-[0.4em] text-xs text-neutral-500 hover:text-white transition duration-300"
>
  ← Motion
</a>

      {next ? (

        <a
          href={`/work/${next.slug}`}
          class="uppercase tracking-[0.4em] text-xs text-neutral-500 hover:text-white transition duration-300"
        >
          Next Project →
        </a>

      ) : (

        <span></span>

      )}

    </div>

  </div>

</section>
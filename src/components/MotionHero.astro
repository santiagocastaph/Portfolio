---
const { project } = Astro.props;
---

<section class="bg-black text-white pt-24 pb-24 md:pt-32 md:pb-40">

  <a
    href={`/work/${project.slug}`}
    class="group block"
  >

    <div class="relative overflow-hidden h-[70vh] md:h-[90vh]">

      <img
        src={project.hero}
        alt={project.title}
        class="absolute inset-0 w-full h-full object-cover transition duration-[1600ms] ease-out group-hover:scale-[1.01]"
      />

      <div class="absolute inset-0 bg-black/20"></div>

      <div class="absolute bottom-16 md:bottom-28 left-0 w-full">

        <div class="max-w-7xl mx-auto px-6 md:px-8">

          <p class="uppercase tracking-[0.45em] text-[10px] md:text-xs text-neutral-200 mb-4 md:mb-5">
            {project.genre}
          </p>

          <h2 class="font-serif text-5xl md:text-7xl lg:text-[7.5rem] leading-[0.9] tracking-[-0.05em] transition duration-300 group-hover:text-white">
            {project.title}
          </h2>

          <p class="mt-5 md:mt-6 uppercase tracking-[0.35em] text-[10px] md:text-xs text-neutral-300">
            {project.year} · {project.type}
          </p>

        </div>

      </div>

    </div>

  </a>

</section>
---
const navItems = [
  { label: "Motion", href: "/motion" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---

<nav class="fixed top-0 left-0 w-full z-50">
  <div class="max-w-7xl mx-auto px-8 py-6 flex items-center justify-between">

    <!-- LOGO -->
    <a
      href="/"
      class="relative z-[60] font-serif text-base tracking-[0.18em] text-white transition duration-300 hover:opacity-60"
    >
      SCG
    </a>

    <!-- DESKTOP NAV -->
    <div class="hidden md:flex items-center gap-10">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="uppercase text-[11px] tracking-[0.35em] text-neutral-400 transition duration-300 hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- MOBILE MENU: CSS toggle -->
    <input id="mobile-menu-toggle" type="checkbox" class="peer sr-only" />
    <label for="mobile-menu-toggle" class="relative z-[60] flex md:hidden w-8 h-8 items-center justify-center cursor-pointer" aria-label="Toggle menu">
      <span class="sr-only">Toggle menu</span>
      <span class="flex flex-col gap-[5px] w-5"><span class="block h-px w-full bg-white"></span><span class="block h-px w-full bg-white"></span></span>
    </label>

    <!-- MOBILE NAV -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-50 bg-black opacity-0 pointer-events-none transition-opacity duration-300 md:hidden peer-checked:opacity-100 peer-checked:pointer-events-auto"
      aria-hidden="true"
      data-mobile-menu
    >
      <div class="h-full flex flex-col justify-center px-8">

        <div class="flex flex-col">
          {navItems.map((item, index) => (
            <a
              href={item.href}
              class="flex items-baseline justify-between border-b border-white/10 py-6 text-white transition-opacity duration-300 hover:opacity-50"
              data-mobile-link
            >
              <span class="font-serif text-4xl tracking-[-0.03em]">
                {item.label}
              </span>

              <span class="text-[10px] uppercase tracking-[0.25em] text-neutral-500">
                {String(index + 1).padStart(2, "0")}
              </span>
            </a>
          ))}
        </div>

      </div>
    </div>

  </div>
</nav>


---
const { project } = Astro.props;

const gallery = project.gallery;

// Only The Hunt for the Last Nazis uses its original image proportions.
// Every other project keeps the existing gallery behaviour.
const isHuntForTheLastNazis =
  project.slug === "the-hunt-for-the-last-nazis";
---

<section class="bg-black pt-16 pb-12">

  <div class="max-w-7xl mx-auto px-8 space-y-14">

    {gallery[0] && (
      <figure class="overflow-hidden">
        <img
          src={gallery[0].image}
          alt={project.title}
          class={
            isHuntForTheLastNazis
              ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
              : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
          }
        />
      </figure>
    )}

    {(gallery[1] || gallery[2]) && (
      <div class="grid md:grid-cols-2 gap-8">

        {gallery[1] && (
          <figure class="overflow-hidden">
            <img
              src={gallery[1].image}
              alt={project.title}
              class={
                isHuntForTheLastNazis
                  ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
                  : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
              }
            />
          </figure>
        )}

        {gallery[2] && (
          <figure class="overflow-hidden">
            <img
              src={gallery[2].image}
              alt={project.title}
              class={
                isHuntForTheLastNazis
                  ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
                  : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
              }
            />
          </figure>
        )}

      </div>
    )}

    {gallery[3] && (
      <figure class="overflow-hidden">
        <img
          src={gallery[3].image}
          alt={project.title}
          class={
            isHuntForTheLastNazis
              ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
              : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
          }
        />
      </figure>
    )}

    {(gallery[4] || gallery[5]) && (
      <div class="grid md:grid-cols-2 gap-8">

        {gallery[4] && (
          <figure class="overflow-hidden">
            <img
              src={gallery[4].image}
              alt={project.title}
              class={
                isHuntForTheLastNazis
                  ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
                  : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
              }
            />
          </figure>
        )}

        {gallery[5] && (
          <figure class="overflow-hidden">
            <img
              src={gallery[5].image}
              alt={project.title}
              class={
                isHuntForTheLastNazis
                  ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
                  : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
              }
            />
          </figure>
        )}

      </div>
    )}

    {gallery[6] && (
      <figure class="overflow-hidden">
        <img
          src={gallery[6].image}
          alt={project.title}
          class={
            isHuntForTheLastNazis
              ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
              : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
          }
        />
      </figure>
    )}

    {(gallery[7] || gallery[8]) && (
      <div class="grid md:grid-cols-2 gap-8">

        {gallery[7] && (
          <figure class="overflow-hidden">
            <img
              src={gallery[7].image}
              alt={project.title}
              class={
                isHuntForTheLastNazis
                  ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
                  : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
              }
            />
          </figure>
        )}

        {gallery[8] && (
          <figure class="overflow-hidden">
            <img
              src={gallery[8].image}
              alt={project.title}
              class={
                isHuntForTheLastNazis
                  ? "w-full h-auto object-contain transition duration-500 hover:scale-[1.01]"
                  : "w-full aspect-video object-cover scale-[1.17] transition duration-500 hover:scale-[1.19]"
              }
            />
          </figure>
        )}

      </div>
    )}

  </div>

</section>
---
import { orderedProjects } from "../data/projects";

const mobilePriority = ["kheper", "the-hunt-for-the-last-nazis", "astray", "items-objects-and-things", "lawless-entanglement", "pact-lunch", "lucid-dreaming", "i-could-hurt-a-fly"];
const mobileProjects = [...mobilePriority.map((slug) => orderedProjects.find((project) => project.slug === slug)!), ...orderedProjects.filter((project) => !mobilePriority.includes(project.slug))];
---

<section class="bg-black px-6 md:px-8 py-10 md:py-14">
  <div class="mx-auto max-w-[1600px]">

    <div class="space-y-10 md:space-y-14 hidden md:block">

      {Array.from(
        { length: Math.ceil(orderedProjects.length / 7) },
        (_, groupIndex) => {
          const group = orderedProjects.slice(
            groupIndex * 7,
            groupIndex * 7 + 7
          );

          const project = (localIndex: number) => group[localIndex];

          return (
            <div class="space-y-8">

              <!-- FIRST COMPOSITION: 01 + 02/03/04/05 -->
              {group.length > 0 && (
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">

                  <!-- LARGE PROJECT -->
                  {project(0) && (
                    <article class="group md:col-span-6 flex flex-col min-h-0">

                      <div class="border-t border-white/30 pt-2 mb-3">
                        <div class="flex items-center gap-4">

                          <span class="text-[10px] tracking-[0.18em] text-white/50">
                            {String(groupIndex * 7 + 1).padStart(2, "0")}
                          </span>

                          <span class="text-[10px] uppercase tracking-[0.18em] text-white/85">
                            {project(0).title}
                          </span>

                          <span class="text-[10px] uppercase tracking-[0.18em] text-white/50">
                            — {project(0).role}
                          </span>

                        </div>
                      </div>

                      <a
                        href={`/work/${project(0).slug}`}
                        class="block overflow-hidden flex-1 min-h-0"
                      >
                        <img
                          src={project(0).hero}
                          alt={project(0).title}
                          class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]"
                          loading={groupIndex === 0 ? "eager" : "lazy"}
                        />
                      </a>

                    </article>
                  )}

                  <!-- FOUR SMALL PROJECTS -->
                  {group.length > 1 && (
                    <div class="md:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">

                      {group.slice(1, 5).map((project, smallIndex) => {
                        const index = groupIndex * 7 + smallIndex + 1;

                        return (
                          <article class="group min-w-0">

                            <div class="border-t border-white/30 pt-2 mb-3">
                              <div class="flex items-center gap-4">

                                <span class="text-[10px] tracking-[0.18em] text-white/50">
                                  {String(index + 1).padStart(2, "0")}
                                </span>

                                <span class="text-[10px] uppercase tracking-[0.18em] text-white/85">
                                  {project.title}
                                </span>

                                <span class="text-[10px] uppercase tracking-[0.18em] text-white/50">
                                  — {project.role}
                                </span>

                              </div>
                            </div>

                            <a
                              href={`/work/${project.slug}`}
                              class="block overflow-hidden aspect-[16/10]"
                            >
                              <img
                                src={project.hero}
                                alt={project.title}
                                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]"
                                loading="lazy"
                              />
                            </a>

                          </article>
                        );
                      })}

                    </div>
                  )}

                </div>
              )}

              <!-- SECOND COMPOSITION: 06 + 07 -->
              {group.length > 5 && (
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">

                  {group.slice(5, 7).map((project, bottomIndex) => {
                    const index = groupIndex * 7 + bottomIndex + 5;

                    return (
                      <article class="group md:col-span-6 min-w-0">

                        <div class="border-t border-white/30 pt-2 mb-3">
                          <div class="flex items-center gap-4">

                            <span class="text-[10px] tracking-[0.18em] text-white/50">
                              {String(index + 1).padStart(2, "0")}
                            </span>

                            <span class="text-[10px] uppercase tracking-[0.18em] text-white/85">
                              {project.title}
                            </span>

                            <span class="text-[10px] uppercase tracking-[0.18em] text-white/50">
                              — {project.role}
                            </span>

                          </div>
                        </div>

                        <a
                          href={`/work/${project.slug}`}
                          class="block overflow-hidden aspect-[16/10]"
                        >
                          <img
                            src={project.hero}
                            alt={project.title}
                            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]"
                            loading="lazy"
                          />
                        </a>

                      </article>
                    );
                  })}

                </div>
              )}

            </div>
          );
        }
      )}

    </div>

    <!-- MOBILE: independent project sequence -->
    <div class="md:hidden space-y-9">
      {mobileProjects.map((project, index) => (
        <article class="group">
          <div class="border-t border-white/30 pt-2 mb-3">
            <div class="flex items-baseline gap-3">
              <span class="text-[10px] tracking-[0.18em] text-white/50">{String(index + 1).padStart(2, "0")}</span>
              <span class="text-[10px] uppercase tracking-[0.18em] text-white/85">{project.title}</span>
              <span class="text-[10px] uppercase tracking-[0.18em] text-white/50">— {project.role}</span>
            </div>
          </div>
          <a href={`/work/${project.slug}`} class="block overflow-hidden">
            <img src={project.hero} alt={project.title} class="w-full h-auto object-cover" loading={index === 0 ? "eager" : "lazy"} />
          </a>
        </article>
      ))}
    </div>

  </div>
</section>
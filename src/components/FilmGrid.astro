---
import { projects } from "../data/projects";
import FilmCard from "./FilmCard.astro";
---

<section class="bg-black px-6 md:px-8 py-20">

  <div class="mx-auto max-w-[1600px] grid grid-cols-12 gap-3">

    {projects.map((project, index) => {

      const layouts = [
        "col-span-12 md:col-span-8 aspect-[16/10]",
        "col-span-12 md:col-span-4 aspect-[4/5]",
        "col-span-12 md:col-span-4 aspect-square",
        "col-span-12 md:col-span-8 aspect-[16/10]",
        "col-span-12 md:col-span-6 aspect-[3/2]",
        "col-span-12 md:col-span-6 aspect-[3/2]",
        "col-span-12 md:col-span-8 aspect-[16/9]",
        "col-span-12 md:col-span-4 aspect-square",
      ];

      return (
        <FilmCard
          project={project}
          className={layouts[index % layouts.length]}
        />
      );

    })}

  </div>

</section>
const years = [...new Set(credits.map((credit) => credit.year))];
---

<Layout title="Credits | Santiago Castañeda Gomez">
  <main class="min-h-screen bg-black text-white">
    <section class="px-8 pt-36 pb-24">
      <div class="mx-auto max-w-[1500px]">
        <div class="flex items-end justify-between border-b border-white/15 pb-8">
          <div>
            <p class="mb-5 uppercase tracking-[0.45em] text-[20px] text-neutral-500">Credits</p>
            <h1 class="font-serif text-4xl leading-none tracking-[-0.045em] md:text-5xl">Selected work</h1>
          </div>
          <a href="/about" class="hidden uppercase tracking-[0.35em] text-[10px] text-neutral-500 transition hover:text-white md:block">About →</a>
        </div>

        <div class="mt-5">
          <div class="hidden grid-cols-12 gap-4 border-b border-white/10 pb-5 md:grid">
            <span class="col-span-1 uppercase tracking-[0.3em] text-[12px] text-neutral-500">Year</span>
            <span class="col-span-5 uppercase tracking-[0.3em] text-[12px] text-neutral-500">Production</span>
            <span class="col-span-3 uppercase tracking-[0.3em] text-[12px] text-neutral-500">Role</span>
            <span class="col-span-3 text-right uppercase tracking-[0.3em] text-[12px] text-neutral-500">Type</span>
          </div>

          {years.map((year) => (
            <div class="pt-10" key={year}>
              <div class="pb-3">
                <p class="font-serif text-2xl tracking-[-0.02em]">{year}</p>
              </div>

              <div class="border-b border-white/10">
                {credits.filter((credit) => credit.year === year).map((credit) => (
                  <div class="grid grid-cols-12 gap-3 border-t border-white/10 py-5 md:gap-4" key={`${credit.year}-${credit.production}`}>
                    <span class="hidden text-xs text-neutral-500 md:col-span-1 md:block">{credit.year}</span>
                    <span class="col-span-12 text-sm md:col-span-5">{credit.production}</span>
                    <span class="col-span-7 text-xs text-neutral-400 md:col-span-3">{credit.role}</span>
                    <span class="col-span-5 text-right text-xs text-neutral-500 md:col-span-3">{credit.type}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 md:hidden">
          <a href="/about" class="uppercase tracking-[0.35em] text-[10px] text-neutral-500 transition hover:text-white">← About</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

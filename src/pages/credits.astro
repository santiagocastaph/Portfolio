  { year: 2026, production: "SEIMA", role: "Camera Operator", type: "Corporate Video" },
  { year: 2026, production: "Department of Environment and Water SA", role: "1st Camera Assistant", type: "Short Documentary" },
  { year: 2026, production: "Cold Like Snow", role: "Director of Photography", type: "Short Film" },

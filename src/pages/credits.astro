  { year: 2025, production: "Tone Deaf Princess", role: "Cinematographer", type: "Short Film" },
  { year: 2025, production: "Lawless Entanglement", role: "1st Camera Assistant", type: "Short Film" },
  { year: 2025, production: "DROP", role: "Director of Photography", type: "Short Film" },
  { year: 2025, production: "Keepher", role: "1st Camera Assistant", type: "Short Film" },
  { year: 2025, production: "Terra Axis – Cardinal Sin", role: "Co-Cinematographer", type: "Music Video" },
  { year: 2025, production: "PRINT", role: "1st Camera Assistant", type: "Short Film" },

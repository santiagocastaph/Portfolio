---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="About | Santiago Castañeda Gomez">

  <Navbar />

  <section class="bg-black text-white min-h-screen pt-40 pb-32">

    <div class="max-w-5xl mx-auto px-8">

      <p class="uppercase tracking-[0.45em] text-xs text-neutral-500 mb-10">
        About
      </p>

      <h1 class="font-serif text-6xl md:text-8xl leading-[0.95] tracking-[-0.05em]">

        Precision behind the camera.

        <br />

        Curiosity behind every story.

      </h1>

      <div class="mt-24 max-w-3xl space-y-8 text-xl leading-relaxed text-neutral-300">

        <p>

          I'm a 1st Assistant Camera based in Adelaide, Australia,
          with a background in photography, journalism and screen production.

        </p>

        <p>

          My work is driven by technical precision, collaboration and
          a deep appreciation for visual storytelling.

        </p>

        <p>

          Whether working on narrative films, documentaries or commercial
          productions, I believe every frame deserves the same level of care.

        </p>

      </div>

    </div>

  </section>

</Layout>
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | Santiago Castañeda Gomez">

  <main class="bg-black text-white">

<!-- ========================================= -->
<!-- CINEMATIC PORTRAIT -->
<!-- ========================================= -->

<section class="about-portrait relative min-h-[72svh] md:min-h-[82svh] overflow-hidden bg-black">
  <img
    src="/about/about-02.jpg"
    alt="Santiago Castañeda operating a cinema camera"
    class="about-portrait-image absolute inset-0 h-full w-full object-cover"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-black/35"></div>

  <div class="relative z-10 flex min-h-[72svh] md:min-h-[82svh] flex-col justify-between px-6 py-7 md:px-12 md:py-10 lg:px-16">
    <div class="flex justify-between items-start">
      <p class="uppercase tracking-[0.3em] text-[10px] text-white/70">About</p>
      <p class="text-right uppercase tracking-[0.2em] text-[9px] md:text-[10px] leading-relaxed text-white/60">
        Adelaide, Australia<br />Camera Department
      </p>
    </div>

    <div class="max-w-[900px]">
      <p class="mb-4 uppercase tracking-[0.28em] text-[10px] md:text-xs text-white/70">1st AC / Focus Puller</p>
      <h1 class="font-serif text-[clamp(3rem,7.5vw,7.5rem)] leading-[0.88] tracking-[-0.055em]">
        Santiago<br class="md:hidden" /> Castañeda Gómez
      </h1>
      <p class="mt-5 text-xs md:text-sm text-white/70">Cinematography · Camera Assistant · Focus Puller</p>
    </div>
  </div>
</section>

<style>
  .about-portrait-image { object-position: 55% center; }
  @media (min-width: 768px) {
    .about-portrait-image { object-position: center 42%; }
  }
</style>

<!-- ========================================= -->
    <!-- SELECTED CREDITS -->
    <!-- ========================================= -->

    <section class="border-t border-white/15">

      <div class="max-w-[1500px] mx-auto px-8 py-7">

        <div class="flex items-end justify-between mb-7">

          <div>
            <h2 class="font-serif text-4xl md:text-7xl tracking-[-0.04em]">
              Selected Credits
            </h2>
          </div>

          <a
            href="/credits"
            class="uppercase tracking-[0.28em] text-sm text-neutral-400 hover:text-white transition"
          >
            View Full Credits →
          </a>

        </div>


        <div class="border-t border-white/20">

          <!-- CREDIT -->
          <a
            href="/work/the-hunt-for-the-last-nazis"
            class="selected-credit-row grid gap-x-4 gap-y-2 py-4 md:py-6 border-b border-white/10 hover:text-neutral-400 transition"
          >
            <span class="credit-year text-[10px] text-neutral-500">
              2026
            </span>

            <span class="credit-title min-w-0 break-words text-sm uppercase tracking-[0.18em]">
              The Hunt for the Last Nazis
            </span>

            <span class="credit-role min-w-0 break-words text-[10px] uppercase tracking-[0.18em] text-neutral-500">
              Camera Assistant
            </span>

            <span class="credit-type hidden md:block text-right text-[10px] uppercase tracking-[0.18em] text-neutral-600">
              SBS Documentary
            </span>
          </a>


          <a
            href="/work/kheper"
            class="selected-credit-row grid gap-x-4 gap-y-2 py-4 md:py-6 border-b border-white/10 hover:text-neutral-400 transition"
          >
            <span class="credit-year text-[10px] text-neutral-500">
              2025
            </span>

            <span class="credit-title min-w-0 break-words text-sm uppercase tracking-[0.18em]">
              Kheper
            </span>

            <span class="credit-role min-w-0 break-words text-[10px] uppercase tracking-[0.18em] text-neutral-500">
              1st Assistant Camera
            </span>

            <span class="credit-type hidden md:block text-right text-[10px] uppercase tracking-[0.18em] text-neutral-600">
              Short Film
            </span>
          </a>

<a
  href="/work/lawless-entanglement"
  class="selected-credit-row grid gap-x-4 gap-y-2 py-4 md:py-6 border-b border-white/10 hover:text-neutral-400 transition"
>
  <span class="credit-year text-[10px] text-neutral-500">
    2025
  </span>

  <span class="credit-title min-w-0 break-words text-sm uppercase tracking-[0.18em]">
    Lawless Entanglement
  </span>

  <span class="credit-role min-w-0 break-words text-[10px] uppercase tracking-[0.18em] text-neutral-500">
    1st Camera Assistant
  </span>

  <span class="credit-type hidden md:block text-right text-[10px] uppercase tracking-[0.18em] text-neutral-600">
    Short Film
  </span>
</a>

          <a
            href="/work/pact-lunch"
            class="selected-credit-row grid gap-x-4 gap-y-2 py-4 md:py-6 border-b border-white/10 hover:text-neutral-400 transition"
          >
            <span class="credit-year text-[10px] text-neutral-500">
              2025
            </span>

            <span class="credit-title min-w-0 break-words text-sm uppercase tracking-[0.18em]">
              Pact Lunch
            </span>

            <span class="credit-role min-w-0 break-words text-[10px] uppercase tracking-[0.18em] text-neutral-500">
              1st AC / Clapper Loader
            </span>

            <span class="credit-type hidden md:block text-right text-[10px] uppercase tracking-[0.18em] text-neutral-600">
              Short Film
            </span>
          </a>


          <a
            href="/work/odysseed"
            class="selected-credit-row grid gap-x-4 gap-y-2 py-4 md:py-6 border-b border-white/10 hover:text-neutral-400 transition"
          >
            <span class="credit-year text-[10px] text-neutral-500">
              2025
            </span>

            <span class="credit-title min-w-0 break-words text-sm uppercase tracking-[0.18em]">
              Odysseed
            </span>

            <span class="credit-role min-w-0 break-words text-[10px] uppercase tracking-[0.18em] text-neutral-500">
              Director of Photography
            </span>

            <span class="credit-type hidden md:block text-right text-[10px] uppercase tracking-[0.18em] text-neutral-600">
              Short Film
            </span>
          </a>

        </div>


        <div class="mt-8 md:hidden">
          <a
            href="/credits"
            class="uppercase tracking-[0.35em] text-[10px] text-neutral-500 hover:text-white transition"
          >
            View Full Credits →
          </a>
        </div>

      </div>

    </section>


 <!-- ========================================= -->
<!-- STATEMENT -->
<!-- ========================================= -->

<section class="border-t border-white/15">
  <div class="max-w-[1500px] mx-auto px-8 py-20 md:py-24">

  <div class="grid grid-cols-1 md:grid-cols-12 gap-16 md:gap-20 items-start">

    <!-- PRIMARY STATEMENT -->
    <div class="md:col-span-7">
      <p class="font-serif text-4xl md:text-[3.8rem] lg:text-[4rem] leading-[0.98] tracking-[-0.04em]">
        I work in the camera department, primarily as a 1st AC / Focus Puller,
        with a background in cinematography, photojournalism and media.
      </p>
    </div>

    <!-- CREATIVE STATEMENT -->
    <div class="md:col-span-5 md:pt-6 lg:pt-8">
      <p class="font-serif text-2xl md:text-[2.1rem] lg:text-[2.2rem] leading-[1.05] tracking-[-0.025em]">
        I believe in making art that means something to someone. 
      </p>
    </div>

  </div>

</div>
</section>


  </main>


<style>
  .selected-credit-row { grid-template-columns: 56px minmax(0, 1fr); }
  .credit-year { grid-column: 1; grid-row: 1; }
  .credit-title { grid-column: 2; grid-row: 1; }
  .credit-role { grid-column: 2; grid-row: 2; }
  @media (min-width: 768px) {
    .selected-credit-row { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .credit-year { grid-column: span 1; grid-row: auto; }
    .credit-title { grid-column: span 5; grid-row: auto; }
    .credit-role { grid-column: span 3; grid-row: auto; }
    .credit-type { grid-column: span 3; }
  }
</style>
</Layout>
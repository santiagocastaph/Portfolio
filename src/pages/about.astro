---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | Santiago Castañeda Gomez">

  <main class="bg-black text-white">

<!-- ========================================= -->
<!-- ABOUT EDITORIAL LAYOUT -->
<section class="about-editorial border-b border-white/15" style="display:grid;grid-template-columns:12px minmax(0,42fr) minmax(0,58fr);">
  <div class="about-photo relative min-h-[52svh] md:min-h-[calc(100vh-72px)] bg-black overflow-hidden">
    <img
      src="/about/about-02.jpg"
      alt="Santiago Castañeda operating a cinema camera"
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-black/15"></div>
    <span class="absolute bottom-5 left-5 md:bottom-8 md:left-8 text-[9px] uppercase tracking-[0.28em] text-white/65">On set · Adelaide</span>
  </div>

  <div class="about-copy flex flex-col px-7 py-9 md:px-12 lg:px-16 xl:px-20 md:py-10">
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | Santiago Castañeda Gomez">

  <main class="bg-black text-white">

<!-- ========================================= -->
<!-- ABOUT EDITORIAL LAYOUT -->
<section class="about-editorial border-b border-white/15" style="display:grid;grid-template-columns:12px minmax(0,42fr) minmax(0,58fr);">
  <div class="about-photo relative min-h-[52svh] md:min-h-[calc(100vh-72px)] bg-black overflow-hidden">
    <img
      src="/about/about-02.jpg"
      alt="Santiago Castañeda operating a cinema camera"
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-black/15"></div>
    <span class="absolute bottom-5 left-5 md:bottom-8 md:left-8 text-[9px] uppercase tracking-[0.28em] text-white/65">On set · Adelaide</span>
  </div>

  <div class="about-copy flex flex-col px-7 py-9 md:px-12 lg:px-16 xl:px-20 md:py-10">
    <div class="flex justify-between items-start mb-10 md:mb-12">
      <span class="text-[10px] uppercase tracking-[0.3em] text-neutral-500">About</span>
      <span class="text-right text-[9px] md:text-[10px] uppercase tracking-[0.2em] leading-relaxed text-neutral-500">Adelaide · Australia</span>
    </div>

    <div class="mb-10 md:mb-12">
      <h1 class="font-serif text-[clamp(2.5rem,3.25vw,3.8rem)] leading-[0.98] tracking-[-0.045em]">Santiago Castañeda</h1>
      <p class="mt-5 max-w-[34rem] text-[10px] md:text-xs uppercase tracking-[0.16em] leading-[1.8] text-neutral-400">Camera Department <span class="mx-2 text-neutral-700">/</span> 1st AC · Focus Puller</p>
    </div>


---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import MotionHero from "../components/MotionHero.astro";
import { projects } from "../data/projects";
---

<Layout title="Motion | Santiago Castañeda Gomez">

  <Navbar />

  <section class="bg-black text-white min-h-screen">

    <MotionHero project={projects[0]} />

<div class="h-[100px] bg-black"></div>

<div>

      <div class="space-y-52">

        {projects.slice(1).map((project) => (

          <a
            href={`/work/${project.slug}`}
            class="group block"
          >

            <div class="relative overflow-hidden h-[90vh]">

              <img
                src={project.hero}
                alt={project.title}
                class="absolute inset-0 w-full h-full object-cover transition duration-[1600ms] ease-out group-hover:scale-[1.01]"
              />

              <div class="absolute inset-0 bg-black/20"></div>

              <div class="absolute bottom-28 left-0 w-full">

                <div class="max-w-7xl mx-auto px-8">

                  <p class="uppercase tracking-[0.45em] text-xs text-neutral-200 mb-5">
                    {project.genre}
                  </p>

                  <h2 class="font-serif text-6xl md:text-7xl lg:text-[7.5rem] leading-[0.9] tracking-[-0.05em]">
                    {project.title}
                  </h2>

                  <p class="mt-6 uppercase tracking-[0.35em] text-xs text-neutral-300">
                    {project.year} · {project.type}
                  </p>

                </div>

              </div>

            </div>

          </a>

        ))}

      </div>

    </div>

  </section>

</Layout>
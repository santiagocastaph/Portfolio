---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FilmGrid from "../components/FilmGrid.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Motion | Santiago Castañeda Gomez</title>
  </head>
  <body class="bg-black text-white">
    <Navbar />

  <main class="bg-black text-white min-h-screen">

    <section style="padding-top: 0; padding-bottom: 160px;">

      <div class="max-w-[1600px] mx-auto px-6 md:px-8" style="padding-top: 112px; margin-bottom: 36px;">
        <h1 class="font-serif text-3xl md:text-[2.15rem] tracking-[-0.04em]" style="position: relative; z-index: 1; line-height: 1.1;">Selected Projects</h1>
      </div>

      <FilmGrid />

    </section>

  </main>

    <Footer />
  </body>
</html>

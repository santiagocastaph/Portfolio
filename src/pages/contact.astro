---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Santiago Castañeda Gomez">
  <section class="min-h-[calc(100vh-5rem)] bg-black px-8 pb-16 pt-28 text-white flex items-center">
    <div class="mx-auto w-full max-w-[1000px]">

      <div class="grid grid-cols-1 gap-12 border-b border-white/15 pb-12 md:grid-cols-12 md:gap-16 md:pb-20">
        
        <h1 class="font-serif text-6xl leading-[0.85] tracking-[-0.05em] md:col-span-7 md:text-7xl">
          Contact
        </h1>

        <p class="max-w-sm self-center text-base leading-7 text-neutral-400 md:col-span-5">
          Available for camera department work and selected cinematography projects.
        </p>

      </div>

      <div class="grid grid-cols-1 gap-12 py-14 md:grid-cols-12 md:gap-16 md:py-16">

        <div class="md:col-span-7">

          <p class="mb-5 text-[10px] uppercase tracking-[0.4em] text-neutral-500">
            Email
          </p>

          <a
            href="mailto:Santiagocastaph@gmail.com?subject=Film%20Project%20Enquiry"
            class="font-serif text-3xl leading-tight tracking-[-0.03em] text-white transition hover:text-neutral-400 md:text-4xl"
          >
            Santiagocastaph@gmail.com
          </a>

        </div>

        <div class="space-y-5 md:col-span-5">

          <div>
            <p class="mb-3 text-[10px] uppercase tracking-[0.4em] text-neutral-500">
              Based in
            </p>

            <p class="text-sm leading-6 text-neutral-300">
              Adelaide, Australia
            </p>
          </div>

          <div>
            <p class="mb-3 text-[10px] uppercase tracking-[0.4em] text-neutral-500">
              Available
            </p>

            <p class="text-sm leading-6 text-neutral-300">
              Nationally and internationally
            </p>
          </div>

          <a
            href="https://instagram.com/Santiagocasta.gomez"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-[11px] uppercase tracking-[0.35em] text-neutral-400 transition hover:text-white"
          >
            Instagram ↗
          </a>

        </div>

      </div>

    </div>
  </section>
</Layout>
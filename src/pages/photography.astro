---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Photography | Santiago Castañeda Gomez">

  <Navbar />

  <section class="bg-black text-white min-h-screen pt-40 pb-32">

    <div class="max-w-7xl mx-auto px-8">

      <h1 class="font-serif text-7xl md:text-9xl tracking-[-0.05em]">
        Photography
      </h1>

      <p class="mt-8 text-neutral-500 max-w-xl leading-relaxed">
        Documentary, portrait and visual observations collected over the years.
      </p>

      <div class="mt-32 grid grid-cols-1 md:grid-cols-2 gap-10">

        <div class="aspect-[4/5] bg-neutral-900"></div>

        <div class="aspect-[4/5] bg-neutral-900"></div>

        <div class="aspect-[4/5] bg-neutral-900"></div>

        <div class="aspect-[4/5] bg-neutral-900"></div>

        <div class="aspect-[4/5] bg-neutral-900"></div>

        <div class="aspect-[4/5] bg-neutral-900"></div>

      </div>

    </div>

  </section>

</Layout>